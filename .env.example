# Agent execution through a local OpenAI-compatible vLLM server.
AGENT_MODEL_NAME=/path/to/local/model-or-served-model-name
AGENT_API_KEY=EMPTY
AGENT_API_BASE_URL=http://127.0.0.1:8000/v1

# Workflow-memory construction through a separate OpenAI-compatible API.
MEMORY_BUILD_MODEL_NAME=gpt-4o
MEMORY_BUILD_API_KEY=replace-with-builder-api-key
# Leave empty to use the OpenAI client's official default endpoint.
MEMORY_BUILD_API_BASE_URL=
# Hybrid-thinking models such as qwen3.5-plus should use false for workflow extraction.
# Leave empty for providers or models that do not support this parameter.
MEMORY_BUILD_ENABLE_THINKING=

# Embedding model. Key/base fall back to the agent values when omitted.
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_MODEL_KEY=
EMBEDDING_MODEL_BASE_URL=

# ALFWorld 0.4.2 data root created by alfworld-download.
ALFWORLD_DATA=/path/to/alfworld-data
